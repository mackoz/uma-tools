{
  "name": "uma-tools",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "cd umalator-global && node build.mjs --serve",
    "dev:global": "cd umalator-global && node build.mjs --serve",
    "dev:skill-visualizer-global": "cd skill-visualizer-global && node build.mjs --serve",
    "build:umalator": "cd umalator && node build.mjs",
    "build:umalator-global": "cd umalator-global && node build.mjs",
    "build:skill-visualizer-global": "cd skill-visualizer-global && node build.mjs",
    "build:skill-visualizer": "cd skill-visualizer && node build.mjs",
    "build:courseimages": "cd courseimages && node build.mjs",
    "build:rougelike": "cd rougelike && node build.mjs",
    "build:umadle": "cd umadle && node build.mjs",
    "build": "npm run build:umalator && npm run build:umalator-global && npm run build:skill-visualizer-global && npm run build:skill-visualizer && npm run build:courseimages && npm run build:rougelike && npm run build:umadle",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:baseline": "node scripts/verify.mjs --baseline",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --experimental-strip-types umalator/statisticalAnalysis.test.ts && node --experimental-strip-types umalator/chartLadder.test.ts && node --experimental-strip-types umalator/shopSkillFilter.test.ts",
    "test:stats": "npm run test",
    "prepare": "husky"
  },
  "author": "pecan",
  "license": "GPL-3.0-or-later",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "commander": "^13.1.0",
    "esbuild": "^0.19.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.2",
    "accessible-autocomplete": "^3.0.1",
    "d3": "^7.9.0",
    "immutable": "^5.0.3",
    "lucide-preact": "^0.562.0",
    "posthog-js": "^1.257.0",
    "prando": "^6.0.1",
    "preact": "^10.18.1",
    "preact-i18n": "^2.4.0-preactx",
    "unassert-cli": "github:unassert-js/unassert-cli"
  }
}
